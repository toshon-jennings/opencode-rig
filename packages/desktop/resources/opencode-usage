#!/bin/bash
# Prints per-model token and cost totals from the local OpenCode databases as a
# `sqlite3 -header -column` table. Consumed by the workbench usage panel
# (packages/app/src/pages/session/usage-panel.tsx), which expects exactly these
# nine columns plus a trailing TOTAL row.
#
# OpenCode keeps a separate database per release channel (opencode.db,
# opencode-dev.db, ...), so a single build only ever sees a slice of the history.
# Totals are aggregated across every channel database sitting next to $OPENCODE_DB.
# Each is attached read-only: this reports on the data, it never writes to it.
DB="${OPENCODE_DB:-$HOME/.local/share/opencode/opencode.db}"
DIR="$(dirname "$DB")"

# Checked up front because the probe below discards sqlite3's stderr: without this,
# a missing sqlite3 makes every candidate database look unreadable and the script
# blames the data ("No OpenCode database with usage data found") instead of the
# missing tool. Note that the sqlite3 *library* is not the sqlite3 *binary* — a
# system can have libsqlite3 and still not have the CLI this script needs.
if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "sqlite3 was not found on PATH. The usage report needs the sqlite3 command-line tool" >&2
  echo "(the libsqlite3 shared library alone is not enough)." >&2
  echo "Debian/Ubuntu: sudo apt install sqlite3   macOS: preinstalled, or brew install sqlite" >&2
  exit 127
fi

attach=""
union=""
count=0
for candidate in "$DIR"/opencode*.db; do
  # Skips stray or half-created files; an empty database would otherwise abort the query.
  [ -s "$candidate" ] || continue
  [ -n "$(sqlite3 "$candidate" "SELECT 1 FROM sqlite_master WHERE type='table' AND name='message'" 2>/dev/null)" ] || continue
  count=$((count + 1))
  escaped=$(printf '%s' "$candidate" | sed "s/'/''/g")
  attach="${attach}ATTACH DATABASE 'file:${escaped}?mode=ro' AS db${count};"
  [ -n "$union" ] && union="${union} UNION ALL "
  union="${union}SELECT data FROM db${count}.message"
done

if [ "$count" -eq 0 ]; then
  echo "No OpenCode database with usage data found in $DIR" >&2
  exit 1
fi

sqlite3 -header -column "" "
$attach
WITH messages AS ($union)
SELECT model, provider, msgs, input, output, reasoning, cache_read, cache_write, cost FROM (
  SELECT COALESCE(json_extract(data,'\$.modelID'),'unknown') AS model,
         COALESCE(json_extract(data,'\$.providerID'),'unknown') AS provider,
         COUNT(*) AS msgs,
         SUM(json_extract(data,'\$.tokens.input')) AS input,
         SUM(json_extract(data,'\$.tokens.output')) AS output,
         SUM(json_extract(data,'\$.tokens.reasoning')) AS reasoning,
         SUM(json_extract(data,'\$.tokens.cache.read')) AS cache_read,
         SUM(json_extract(data,'\$.tokens.cache.write')) AS cache_write,
         SUM(json_extract(data,'\$.cost')) AS cost
  FROM messages WHERE json_extract(data,'\$.role')='assistant'
  GROUP BY json_extract(data,'\$.modelID'), json_extract(data,'\$.providerID')
  UNION ALL
  SELECT 'TOTAL', '-', COUNT(*),
         SUM(json_extract(data,'\$.tokens.input')),
         SUM(json_extract(data,'\$.tokens.output')),
         SUM(json_extract(data,'\$.tokens.reasoning')),
         SUM(json_extract(data,'\$.tokens.cache.read')),
         SUM(json_extract(data,'\$.tokens.cache.write')),
         SUM(json_extract(data,'\$.cost'))
  FROM messages WHERE json_extract(data,'\$.role')='assistant'
) ORDER BY CASE WHEN model='TOTAL' THEN 1 ELSE 0 END, input DESC"
